{
  "name": "dsh-mermaid-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preview Mermaid diagrams rendered from Mermaid code blocks in the DeepSeek Harness Web UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.mermaid.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "mermaid": "12.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
